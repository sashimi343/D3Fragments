@page
@model IndexModel
@{
    ViewData["Title"] = "Library demo";
}

<div class="text-center">
    <h1 class="display-5">D3Fragments Library Demo</h1>
    <p>Start by registering members and books, then try borrowing, reserving and returning.</p>
    <p><a asp-page="/Books/Index" class="btn btn-primary">Books</a>
       <a asp-page="/Members/Register" class="btn btn-outline-primary">Register as a member</a>
       <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Administrator (librarian)</a></p>
    <p class="alert alert-warning">This demo is for local use only. Do not run it publicly: sign-in needs only an email address and the administrator page has no authentication. Data is lost on restart.</p>
</div>
