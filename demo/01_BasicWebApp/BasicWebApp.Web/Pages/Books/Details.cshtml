@page "{id}"
@using D3Fragments.Extensions
@using BasicWebApp.Domain.Books
@model BasicWebApp.Web.Pages.Books.DetailsModel
@{
    ViewData["Title"] = "Book details";
}
<h1>Book details</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Book is { } book)
{
    <dl class="row">
        <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@book.Title</dd>
        <dt class="col-sm-3">Author</dt><dd class="col-sm-9">@book.Author</dd>
        <dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@book.Isbn</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@book.Status.GetDisplayName()</dd>
    </dl>
    <h2 class="h4">Reservation queue</h2>
    @if (book.Reservations.Count == 0)
    {
        <p>There are no reservations.</p>
    }
    else
    {
        <ol>
            @foreach (var reservation in book.Reservations)
            {
                <li>
                    @(reservation.MemberId == Model.CurrentMemberId ? "Your reservation" : "Another member's reservation")
                    / Reserved on: @reservation.ReservedOn
                    @if (reservation.HoldUntil is { } until)
                    {
                        <span>/ Hold until: @until</span>
                    }
                </li>
            }
        </ol>
    }
    @if (Model.CurrentMemberId is null)
    {
        <p><a asp-page="/Account/Login">Sign in as a member</a> to borrow or reserve books.</p>
    }
    else
    {
        <div class="d-flex gap-2 mb-3">
            @if (book.Status == BookStatus.Available || book.HoldMemberId == Model.CurrentMemberId)
            {
                <form method="post" asp-page-handler="Borrow"><button class="btn btn-primary">Borrow</button></form>
            }
            @if (book.Reservations.Any(r => r.MemberId == Model.CurrentMemberId))
            {
                <form method="post" asp-page-handler="Cancel"><button class="btn btn-outline-danger">Cancel reservation</button></form>
            }
            else if (book.Status != BookStatus.Available)
            {
                <form method="post" asp-page-handler="Reserve"><button class="btn btn-outline-primary">Reserve</button></form>
            }
        </div>
    }
}
<a asp-page="Index">Back to the book list</a>
