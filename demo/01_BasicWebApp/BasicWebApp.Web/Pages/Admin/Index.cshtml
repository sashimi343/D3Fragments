@page
@using D3Fragments.Extensions
@model BasicWebApp.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administrator (librarian)";
}
<h1>Administrator (librarian)</h1>
<p class="alert alert-warning">This is an administration page for the demo only. It has no authentication.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<h2 class="h4">Register a book</h2>
<form method="post" asp-page-handler="Register" asp-route-PageNo="@Model.Books.PageNo" class="mb-4">
    <div class="mb-3">
        <label asp-for="Input.Isbn" class="form-label"></label>
        <input asp-for="Input.Isbn" class="form-control" />
        <span asp-validation-for="Input.Isbn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Author" class="form-label"></label>
        <input asp-for="Input.Author" class="form-control" />
        <span asp-validation-for="Input.Author" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Register book</button>
</form>
<h2 class="h4">Withdraw a book</h2>
<p>Only books that are on the shelf and not reserved can be withdrawn.</p>
<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Title</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var book in Model.Books.Items)
            {
                <tr>
                    <td><a asp-page="/Books/Details" asp-route-id="@book.Id">@book.Title</a></td>
                    <td>@book.Status.GetDisplayName()</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-PageNo="@Model.Books.PageNo">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button class="btn btn-outline-danger btn-sm">Withdraw</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav aria-label="Pages of the book list for administration" class="mb-4">
    <span>Page @Model.Books.PageNo / @Model.Books.TotalPages (@Model.Books.TotalCount books in total)</span>
    @if (Model.Books.HasPrevPage)
    {
        <a asp-route-PageNo="@Model.Books.PrevPage" class="btn btn-outline-secondary">Previous</a>
    }
    @if (Model.Books.HasNextPage)
    {
        <a asp-route-PageNo="@Model.Books.NextPage" class="btn btn-outline-secondary">Next</a>
    }
</nav>
<h2 class="h4">Expire holds</h2>
<p>Runs the equivalent of the daily batch manually through the Controller API.</p>
<button type="button" class="btn btn-outline-primary mb-2" id="expire-holds" data-url="@Url.Content("~/api/holds/expire")">Expire holds</button>
<p id="expiry-result" role="status"></p>
@if (Model.CanAdvanceDate)
{
    <h2 class="h4">Change the date (development only)</h2>
    <p>This affects all members. The date can only move forward and returns to the actual date on restart.</p>
    <form method="post" asp-page-handler="Advance" asp-route-PageNo="@Model.Books.PageNo" class="d-flex gap-2">
        <label asp-for="Days" class="form-label">Days to advance</label>
        <input asp-for="Days" min="1" max="@int.MaxValue" required class="form-control w-auto" />
        <button class="btn btn-outline-primary">Advance the date</button>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $("#expire-holds").on("click", function () {
            const button = $(this);
            const result = $("#expiry-result");
            button.prop("disabled", true);
            result.text("Processing…");
            $.ajax({
                url: button.data("url"),
                method: "POST",
                headers: { "X-Requested-By": "BasicWebApp" }
            }).done(function (data) {
                result.removeClass("text-danger").text("Processed books: " + data.processedCount + ". Refresh the list to check their status.");
            }).fail(function (xhr) {
                result.addClass("text-danger").text("The operation failed (HTTP " + xhr.status + "). " + (xhr.responseJSON?.detail ?? "Please try again."));
            }).always(function () {
                button.prop("disabled", false);
            });
        });
    </script>
}
