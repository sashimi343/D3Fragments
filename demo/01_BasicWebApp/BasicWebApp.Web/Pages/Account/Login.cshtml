@page
@model BasicWebApp.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Member sign-in";
}
<h1>Member sign-in</h1>
<p class="alert alert-warning">This is a temporary sign-in for the demo only. You can sign in with just a registered email address. Do not use real personal information.</p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.EmailAddress" class="form-label"></label>
        <input asp-for="Input.EmailAddress" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
    <a asp-page="/Members/Register" class="btn btn-link">Register as a member</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
