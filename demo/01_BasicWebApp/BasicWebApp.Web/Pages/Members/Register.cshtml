@page
@model BasicWebApp.Web.Pages.Members.RegisterModel
@{
    ViewData["Title"] = "Member registration";
}
<h1>Member registration</h1>
<p>Enter a fictitious name and email address for the demo.</p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.EmailAddress" class="form-label"></label>
        <input asp-for="Input.EmailAddress" class="form-control" />
        <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.MemberTypeKey" class="form-label"></label>
        <select asp-for="Input.MemberTypeKey" class="form-select">
            <option value="">Select one</option>
            @foreach (var memberType in BasicWebApp.Domain.Members.MemberType.Values)
            {
                <option value="@memberType.Key">@memberType.Name (@(memberType.LoanLimit) books, @(memberType.LoanPeriodDays) days)</option>
            }
        </select>
        <span asp-validation-for="Input.MemberTypeKey" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Register</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
