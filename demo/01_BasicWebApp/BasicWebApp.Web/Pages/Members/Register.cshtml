@page
@model BasicWebApp.Web.Pages.Members.RegisterModel
@{
    ViewData["Title"] = "会員登録";
}
<h1>会員登録</h1>
<p>デモ用の架空の氏名とメールアドレスを入力してください。</p>
<form method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.EmailAddress" class="form-label"></label>
        <input asp-for="Input.EmailAddress" class="form-control" />
        <span asp-validation-for="Input.EmailAddress" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.MemberTypeKey" class="form-label"></label>
        <select asp-for="Input.MemberTypeKey" class="form-select">
            <option value="">選択してください</option>
            @foreach (var memberType in BasicWebApp.Domain.Members.MemberType.Values)
            {
                <option value="@memberType.Key">@memberType.Name（@(memberType.LoanLimit)冊・@(memberType.LoanPeriodDays)日）</option>
            }
        </select>
        <span asp-validation-for="Input.MemberTypeKey" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">登録</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
