@page
@model BasicWebApp.Web.Pages.Members.IndexModel
@{
    ViewData["Title"] = "My page";
}
<h1>My page</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.MemberInfo is { } details)
{
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@details.Member.Name</dd>
        <dt class="col-sm-3">Email address</dt><dd class="col-sm-9">@details.Member.EmailAddress</dd>
        <dt class="col-sm-3">Member type</dt><dd class="col-sm-9">@details.Member.MemberType.Name</dd>
        <dt class="col-sm-3">On loan</dt><dd class="col-sm-9">@details.LoanCount / @details.Member.MemberType.LoanLimit books</dd>
        <dt class="col-sm-3">Loan suspension</dt>
        <dd class="col-sm-9">
            @if (details.IsLoanSuspended || details.IsLoanSuspensionScheduled)
            {
                @(details.IsLoanSuspended ? "Suspended" : "Scheduled")<text> (@details.Member.LoanSuspendedFrom - @details.Member.LoanSuspendedUntil)</text>
            }
            else
            {
                <text>Not suspended</text>
            }
        </dd>
    </dl>
}
<h2 class="h4">Books on loan</h2>
@if (Model.Loans.Count == 0)
{
    <p>You have no books on loan.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Title</th><th>Loaned on</th><th>Due date</th><th>Renewals</th><th>Overdue</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Loans)
                {
                    <tr>
                        <td><a asp-page="/Books/Details" asp-route-id="@entry.Loan.BookId">@entry.BookTitle</a></td>
                        <td>@entry.Loan.LoanedOn</td><td>@entry.Loan.DueDate</td><td>@entry.Loan.RenewalCount</td>
                        <td>@(entry.IsOverdue ? "Overdue" : "No")</td>
                        <td>
                            <form method="post" class="d-flex gap-2">
                                <input type="hidden" name="LoanId" value="@entry.Loan.Id" />
                                <button asp-page-handler="Return" class="btn btn-primary btn-sm">Return</button>
                                <button asp-page-handler="Renew" class="btn btn-outline-primary btn-sm">Renew</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<a asp-page="/Books/Index">Find books</a>
