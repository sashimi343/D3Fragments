@page
@model IdentityIntegration.Web.Pages.MyPage.TwoFactorModel
@{
    ViewData["Title"] = "Two-factor authentication settings";
}
<h1>Two-factor authentication settings</h1>

<table class="table w-auto">
    <tr><th>Two-factor authentication</th><td>@(Model.IsEnabled ? "Enabled" : "Disabled")</td></tr>
    <tr><th>Authenticator app</th><td>@(Model.HasAuthenticator ? "Set up" : "Not set up")</td></tr>
    <tr><th>Email verification code</th><td>Available (email address confirmed)</td></tr>
    <tr><th>Recovery codes left</th><td>@Model.RecoveryCodesLeft</td></tr>
    <tr><th>This browser</th><td>@(Model.IsBrowserRemembered ? "Remembered (two-factor authentication skipped)" : "Not remembered")</td></tr>
</table>

<div class="d-flex flex-wrap gap-2">
    <a asp-page="/MyPage/EnableAuthenticator" class="btn btn-primary">Set up authenticator app</a>
    @if (!Model.IsEnabled)
    {
        <form method="post" asp-page-handler="EnableEmail">
            <button class="btn btn-outline-primary" type="submit">Enable with email verification codes</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="RegenerateRecoveryCodes">
            <button class="btn btn-outline-secondary" type="submit">Regenerate recovery codes</button>
        </form>
        <form method="post" asp-page-handler="Disable">
            <button class="btn btn-outline-danger" type="submit">Disable two-factor authentication</button>
        </form>
    }
    @if (Model.IsBrowserRemembered)
    {
        <form method="post" asp-page-handler="ForgetBrowser">
            <button class="btn btn-outline-secondary" type="submit">Forget this browser</button>
        </form>
    }
</div>
<p class="form-text mt-3">
    When two-factor authentication is enabled, you can choose the authenticator app (if set up) or an email verification code at sign-in.
    Signing in with a passkey does not require two-factor authentication, because a passkey is multi-factor by itself.
</p>
