@page
@model IdentityIntegration.Web.Pages.MyPage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator app";
}
<h1>Set up authenticator app</h1>
<ol>
    <li>Get an authenticator app (TOTP) such as Google Authenticator or Microsoft Authenticator.</li>
    <li>
        Scan the following QR code, or enter the key <kbd>@Model.SharedKey</kbd>.
        <div id="qr-code" class="my-3" data-uri="@Model.AuthenticatorUri"></div>
    </li>
    <li>
        Enter the 6-digit code shown in the authenticator app to verify the setup.
        <form method="post" class="col-md-6 mt-2">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label">Verification code</label>
                <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
            </div>
            <button class="btn btn-primary" type="submit">Verify and enable</button>
        </form>
    </li>
</ol>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        const element = document.getElementById('qr-code');
        new QRCode(element, { text: element.dataset.uri, width: 180, height: 180 });
    </script>
}
