@page
@{
    ViewData["Title"] = "Recovery codes";
    string[] codes = TempData["RecoveryCodes"] is string value ? value.Split(' ') : [];
}
<h1>Recovery codes</h1>
@if (codes.Length == 0)
{
    <p>There are no recovery codes to show. Go back to <a asp-page="/MyPage/TwoFactor">two-factor authentication settings</a>.</p>
}
else
{
    <p class="alert alert-warning">Recovery codes are shown only on this page. Keep them in a safe place. When you cannot use either the authenticator app or email, you can sign in with them, one code at a time.</p>
    <ul class="list-unstyled font-monospace fs-5">
        @foreach (string code in codes)
        {
            <li>@code</li>
        }
    </ul>
    <a asp-page="/MyPage/TwoFactor" class="btn btn-primary">Back to two-factor authentication settings</a>
}
