@page
@model IdentityIntegration.Web.Pages.MyPage.IndexModel
@using System.Security.Claims
@{
    ViewData["Title"] = "My page";
    // Sign-in methods (pwd: password or passkey, mfa: two-factor authentication) and the external login provider
    string[] methods = [.. User.FindAll("amr").Select(claim => claim.Value), .. User.FindAll(ClaimTypes.AuthenticationMethod).Select(claim => claim.Value)];
}
<h1>Welcome, @Model.Profile?.Nickname</h1>
<table class="table w-auto">
    <tr><th>Nickname (member)</th><td>@Model.Profile?.Nickname</td></tr>
    <tr><th>Joined on (member)</th><td>@Model.Profile?.JoinedOn.ToString("yyyy-MM-dd")</td></tr>
    <tr><th>User name (Identity)</th><td>@User.Identity!.Name</td></tr>
    <tr><th>Sign-in methods this time</th><td>@string.Join(", ", methods)</td></tr>
</table>
<ul>
    <li><a asp-page="/MyPage/TwoFactor">Two-factor authentication settings</a></li>
    <li><a asp-page="/MyPage/Passkeys">Manage passkeys</a></li>
</ul>
