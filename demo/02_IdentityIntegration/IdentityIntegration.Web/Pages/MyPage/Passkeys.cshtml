@page
@using Microsoft.AspNetCore.WebUtilities
@model IdentityIntegration.Web.Pages.MyPage.PasskeysModel
@{
    ViewData["Title"] = "Manage passkeys";
}
<h1>Manage passkeys</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (Model.Passkeys.Count == 0)
{
    <p>No passkeys are registered.</p>
}
else
{
    <table class="table w-auto">
        <thead><tr><th>Name</th><th>Registered at</th><th></th></tr></thead>
        <tbody>
            @foreach (var passkey in Model.Passkeys)
            {
                <tr>
                    <td>@passkey.Name</td>
                    <td>@passkey.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="credentialId" value="@WebEncoders.Base64UrlEncode(passkey.CredentialId)" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Register a passkey</h2>
<p>Create a passkey in Windows Hello, a smartphone, a password manager, etc. Once registered, you can sign in without a password.</p>
<form method="post" asp-page-handler="Add" class="col-md-6">
    <input type="hidden" name="credentialJson" />
    <div class="mb-3">
        <label class="form-label" for="name">Name (so you can tell which device the passkey is on)</label>
        <input id="name" name="name" class="form-control" value="Passkey" />
    </div>
    <button class="btn btn-primary" type="button" data-passkey-register="@Url.Page("/MyPage/Passkeys", "CreationOptions")">Register a passkey</button>
</form>
@section Scripts {
    <script src="~/js/passkey.js" asp-append-version="true"></script>
}
