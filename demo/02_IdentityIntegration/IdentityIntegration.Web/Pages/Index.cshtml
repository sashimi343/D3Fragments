@page
@{
    ViewData["Title"] = "Home";
}
<h1>ASP.NET Core Identity Integration Demo</h1>
<p>A demo implementing registration, sign-in, two-factor authentication, passkeys and external login with ASP.NET Core Identity, following the D3Fragments architecture.</p>
<p class="alert alert-warning">This demo is for local use only. Do not use real personal information or passwords.</p>
<ul>
    <li><a asp-page="/Account/Register">Register</a> (confirmation emails arrive in Mailpit)</li>
    <li><a asp-page="/Account/Login">Sign in</a> (password, passkey, Keycloak)</li>
    <li><a asp-page="/MyPage/Index">My page</a> (two-factor authentication and passkey settings)</li>
</ul>
