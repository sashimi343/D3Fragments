@page
@using IdentityIntegration.Core.Accounts
@model IdentityIntegration.Web.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
}
<h1>Two-factor authentication</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<ul class="nav nav-tabs mb-3">
    @foreach (TwoFactorMethod method in Model.Methods)
    {
        <li class="nav-item">
            <a class="nav-link @(method == Model.Method ? "active" : "")" asp-route-method="@method" asp-route-rememberMe="@Model.RememberMe" asp-route-returnUrl="@Model.ReturnUrl">
                @(method == TwoFactorMethod.Authenticator ? "Authenticator app" : "Email")
            </a>
        </li>
    }
</ul>

@if (Model.Method == TwoFactorMethod.Email)
{
    <form method="post" asp-page-handler="SendEmailCode" asp-route-rememberMe="@Model.RememberMe" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3">
        <p>A verification code will be sent to your registered email address. You can check the email in Mailpit.</p>
        <button class="btn btn-outline-primary" type="submit">Send verification code</button>
    </form>
}
else
{
    <p>Enter the 6-digit code shown in your authenticator app.</p>
}

<form method="post" asp-route-rememberMe="@Model.RememberMe" asp-route-returnUrl="@Model.ReturnUrl" class="col-md-6">
    <input type="hidden" asp-for="Method" />
    <div class="mb-3">
        <label asp-for="Code" class="form-label">Verification code</label>
        <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMachine" class="form-check-input" />
        <label asp-for="RememberMachine" class="form-check-label">Remember this browser (sign in with just a password next time)</label>
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
</form>
<p class="mt-3">
    If you cannot use either the authenticator app or email, <a asp-page="/Account/LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">sign in with a recovery code</a>.
</p>
