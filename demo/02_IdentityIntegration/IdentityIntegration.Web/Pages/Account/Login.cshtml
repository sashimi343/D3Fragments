@page
@model IdentityIntegration.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-4">
    <section class="col-md-6">
        <h2 class="h5">Password</h2>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label"></label>
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary" type="submit">Sign in</button>
            <a asp-page="/Account/Register" class="btn btn-link">Register</a>
        </form>
    </section>
    <section class="col-md-6">
        <h2 class="h5">Passkey</h2>
        <p>Sign in without a password using a passkey registered on My page.</p>
        <form method="post" asp-page-handler="Passkey" asp-route-returnUrl="@(Request.Query["returnUrl"])" id="passkey-login">
            <input type="hidden" name="credentialJson" />
            <button class="btn btn-outline-primary" type="button" data-passkey-login="@Url.Page("/Account/Login", "PasskeyOptions")">Sign in with a passkey</button>
        </form>

        <h2 class="h5 mt-4">External login</h2>
        <form method="post" asp-page="/Account/ExternalLogin" asp-route-provider="@ExternalLoginProviders.Keycloak">
            <button class="btn btn-outline-secondary" type="submit">Sign in with Keycloak</button>
        </form>
    </section>
</div>
@section Scripts {
    <script src="~/js/passkey.js" asp-append-version="true"></script>
}
