@page
@model IdentityIntegration.Web.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Sign in with a recovery code";
}
<h1>Sign in with a recovery code</h1>
<p>Enter one of the recovery codes shown when you enabled two-factor authentication. A used recovery code cannot be used again.</p>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="RecoveryCode" class="form-label">Recovery code</label>
        <input asp-for="RecoveryCode" class="form-control" autocomplete="off" />
    </div>
    <button class="btn btn-primary" type="submit">Sign in</button>
</form>
