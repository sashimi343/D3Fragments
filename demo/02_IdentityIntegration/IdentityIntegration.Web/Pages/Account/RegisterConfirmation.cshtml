@page
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Confirmation email sent";
    string? mailpitUrl = Configuration["MAILPIT_UI_URL"];
}
<h1>Confirmation email sent</h1>
<p>Open the link in the email to confirm your email address, and then you can sign in.</p>
@if (mailpitUrl is not null)
{
    <p>You can check the email in <a href="@mailpitUrl" target="_blank" rel="noopener">Mailpit</a>.</p>
}
