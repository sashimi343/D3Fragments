@page
@model IdentityIntegration.Web.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Email confirmation";
}
<h1>Email confirmation</h1>
@if (Model.Confirmed)
{
    <p>Your email address has been confirmed. Please <a asp-page="/Account/Login">sign in</a>.</p>
}
else
{
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
}
