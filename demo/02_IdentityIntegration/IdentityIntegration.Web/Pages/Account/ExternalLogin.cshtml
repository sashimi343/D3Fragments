@page
@model IdentityIntegration.Web.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "外部ログイン";
}
<h1>外部ログイン</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.EmailAddress is not null)
{
    <p>@Model.ProviderDisplayName で認証しました。このサイトで使うユーザー名とニックネームを決めて、アカウントを作成してください。</p>
    <form method="post" asp-page-handler="Confirmation" class="col-md-6">
        <div class="mb-3">
            <label class="form-label" for="email">メールアドレス（@Model.ProviderDisplayName から取得）</label>
            <input id="email" class="form-control" value="@Model.EmailAddress" readonly />
        </div>
        <div class="mb-3">
            <label asp-for="UserName" class="form-label">ユーザー名</label>
            <input asp-for="UserName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Nickname" class="form-label">ニックネーム</label>
            <input asp-for="Nickname" class="form-control" />
        </div>
        <button class="btn btn-primary" type="submit">アカウントを作成してログイン</button>
    </form>
}
<p class="mt-3"><a asp-page="/Account/Login">ログイン画面へ戻る</a></p>
