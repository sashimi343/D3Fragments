<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Sashimi343.D3Fragments" Version="0.2.0" />
    <PackageVersion Include="Sashimi343.D3Fragments.Application" Version="0.2.0" />
    <PackageVersion Include="Sashimi343.D3Fragments.AspNetCore" Version="0.2.0" />
    <PackageVersion Include="Sashimi343.D3Fragments.EFCore" Version="0.2.0" />
    <PackageVersion Include="Sashimi343.D3Fragments.Identity.EFCore" Version="0.2.0" />
    <PackageVersion Include="Sashimi343.D3Fragments.Analyzers" Version="0.2.0" />

    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <!-- Microsoft.EntityFrameworkCore.Sqlite が推移的に参照する 2.1.11 の脆弱性（GHSA-2m69-gcr7-jv3q）回避 -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="17.0.0" />
  </ItemGroup>
</Project>
